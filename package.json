{
  "name": "aftershelf",
  "productName": "AfterShelf",
  "version": "0.4.0-Alpha",
  "description": "A local desktop game library with forum browsing and save-aware updates.",
  "private": true,
  "type": "module",
  "main": "app/main.mjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node scripts/check.mjs",
    "icons": "node scripts/build-icons.mjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --x64 --arm64 && node scripts/build-mac-installer.mjs",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aftershelf.desktop",
    "productName": "AfterShelf",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "!app/assets/aftershelf-master.png",
      "!app/assets/aftershelf-16.png",
      "!app/assets/aftershelf-48.png",
      "!app/assets/aftershelf-128.png",
      "!app/assets/aftershelf-512.png",
      "!app/assets/aftershelf-1024.png",
      "!app/assets/*.icns",
      "!app/assets/*.ico",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.games",
      "icon": "app/assets/aftershelf.icns",
      "target": [
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "icon": "app/assets/aftershelf.ico",
      "target": [
        "nsis-web"
      ]
    },
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AfterShelf-Web-Setup-0.4-Alpha-${os}-${arch}.${ext}",
      "appPackageUrl": "https://github.com/Auxetics/AfterShelf/releases/download/0.4-Alpha/aftershelf-0.4.0-Alpha-x64.nsis.7z"
    },
    "artifactName": "AfterShelf-0.4-Alpha-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Auxetics",
        "repo": "AfterShelf",
        "vPrefixedTagName": false,
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Auxetics/AfterShelf.git"
  },
  "author": "Auxetics"
}
